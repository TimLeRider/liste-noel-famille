{
  "name": "liste-noel-famille",
  "version": "1.0.0",
  "private": true,
  "description": "Liste de Noël familiale : idées de cadeaux, cadeaux communs, votes secrets et révélation le 5 décembre.",
  "type": "module",
  "scripts": {
    "start": "npx --yes serve -l 5500 .",
    "test": "node tests/results.test.mjs",
